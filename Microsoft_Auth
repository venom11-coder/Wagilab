@app.route("/Microsoft-login")
def MicrosoftLogin():
    redirect_uri = url_for("MicrosoftCallback", _external=True)
    return oAuth.Fittergem.authorize_redirect(redirect_uri)


@app.route("/signin-Microsoft")
def MicrosoftCallback():
  try:
    token = oAuth.Fittergem.authorize_access_token()
  except Exception as e:
      return jsonify({"error": str(e), "message": "Try logging in again, your session expired."}), 400
  access_token = token["access_token"]

  headers = {
        "Authorization": f"Bearer {access_token}"
    }

  response = requests.get("https://graph.microsoft.com/v1.0/me", headers=headers)

  user_info = response.json()

  Microsoft_id = user_info.get("id")
  Outlook_id = user_info.get("mail") or user_info.get("userPrincipalName")
  full_name = user_info.get("displayName")
  first_name = full_name.split(" ")[0] if full_name else ""
  last_name = " ".join(full_name.split(" ")[1:]) if full_name else ""

  db = SessionLocal()
  user_exist = db.query(User).filter(User.outlook_id == Outlook_id).first()

 
  if not user_exist:
        new_user = User(
           
            user_id =Microsoft_id ,
            outlook_id=Outlook_id,
            full_name=full_name,
            first_name=first_name,
            last_name=last_name
        )
        db.add(new_user)
        db.commit()

  return jsonify({
        
        "ID": Microsoft_id,
        "Outlook": Outlook_id,
        "first_name": first_name,
        "last_name": last_name,
        "full_name": full_name
    })





if __name__ == "__main__":
    port = int(os.environ.get("PORT", 5000))
    app.run(host="0.0.0.0", port=port
, debug=True)
